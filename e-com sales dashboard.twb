      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_0273168511074304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_amount])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_0273168511213569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit_margin])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_0273168515559426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Return Rate' datatype='real' name='[Calculation_0273168516804611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [returned]= &quot;Yes&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_0273168554115076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([total_amount])' />
      </column>
      <column caption='Total Products Sold' datatype='integer' name='[Calculation_0273168555175942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_0273168555671559]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0273168794632200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0273168511213569]/[Calculation_0273168511074304])' />
      </column>
      <column caption='Revenue Leakage rate' datatype='real' name='[Calculation_0273168803012617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [returned] = &quot;Yes&quot; THEN [total_amount] ELSE 0 END) / SUM([total_amount])' />
      </column>
      <column aggregation='None' datatype='integer' name='[Delivery Time Days (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[delivery_time_days]' peg='0' size='1.58' />
      </column>
